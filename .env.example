# MyPets frontend / lightweight BFF
# Copy to .env.local for local development. Never commit real credentials.

# Runtime
APP_ENV=development
BRAND=mypets
SHOW_DEMO_IMPACT=true

# Public URLs
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:3000/api/v1

# Supabase public client values (safe for browser use when RLS is correct)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-side Supabase values — never expose with NEXT_PUBLIC_ prefix
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Prisma / PostgreSQL
# For Vercel use the Supabase transaction pooler connection string where available.
# Example shape only:
# postgresql://postgres.PROJECT_REF:PASSWORD@REGION.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1
DATABASE_URL=

# Providers remain non-live until explicitly configured and reviewed
PAYMENT_PROVIDER=mock
EMAIL_PROVIDER=console
PAYMENTS_LIVE=false
PAYOUTS_ENABLED=false

# Optional observability
LOG_LEVEL=info
