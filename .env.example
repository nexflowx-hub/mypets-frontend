# MyPets frontend
# The frontend has no direct database connection. All operational data comes from the VPS API.

APP_ENV=production
BRAND=mypets

NEXT_PUBLIC_SITE_URL=https://mypets.lat
NEXT_PUBLIC_API_URL=https://api.mypets.lat/v1
NEXT_PUBLIC_SHOW_DEMO_IMPACT=true

# Future browser-side Supabase Auth may use public values only.
# Do not place service-role or database credentials in Vercel frontend env.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
