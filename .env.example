# MyPets frontend
# No direct database credentials belong here. Operational data always comes from the VPS API.

APP_ENV=production
BRAND=mypets

NEXT_PUBLIC_SITE_URL=https://mypets.lat
NEXT_PUBLIC_API_URL=https://api.mypets.lat/v1

# Canonical MyPets Digital Library content release.
# Pin this to an approved mypets-data commit/tag in production.
MYPETS_CONTENT_REF=cfd9b8c9f4a99a426e386637b0684128b613b252

# Dedicated funnel for the first supported MyPets impact project.
# Override when Together We Feed receives its final custom domain.
NEXT_PUBLIC_TWF_URL=https://twf-help.vercel.app

# Public legal disclosure for the Brazilian operator.
# Keep these values in the deployment environment instead of source control.
NEXT_PUBLIC_MYPETS_BR_LEGAL_NAME=
# Pipe-separated address lines, e.g. line 1|line 2|city/state/CEP|Brasil
NEXT_PUBLIC_MYPETS_BR_ADDRESS=
NEXT_PUBLIC_MYPETS_BR_PHONE=
NEXT_PUBLIC_MYPETS_BR_WHATSAPP_URL=
# Optional post-support community destinations. Keep blank until the official invite URLs are available.
NEXT_PUBLIC_MYPETS_WHATSAPP_COMMUNITY_URL=
NEXT_PUBLIC_MYPETS_FACEBOOK_GROUP_URL=
# Optional hosted MP4/WebM for the 1 eBook = 1 kg landing. When blank, the page renders the photo story fallback.
NEXT_PUBLIC_EBOOK_CAMPAIGN_VIDEO_URL=

# Supabase Auth only. Publishable keys are designed for public clients.
# Legacy NEXT_PUBLIC_SUPABASE_ANON_KEY remains supported as fallback.
NEXT_PUBLIC_SUPABASE_URL=https://PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
